# JobMatchr AI — server configuration
# Copy this file to .env and adjust values (Node 20+ supports: node --env-file=.env server/index.mjs)

# --- Networking ---
# Port the proxy listens on (default 4000)
PORT=4000

# Bind host (0.0.0.0 exposes to the network — keep 127.0.0.1 if only localhost should connect)
HOST=0.0.0.0

# --- TLS ---
# Recommended for production: terminate TLS at a reverse proxy (nginx/Caddy) with a real
# certificate and run this server plain HTTP on 127.0.0.1. Alternatively set the paths below:
# SSL_CERT=/path/to/fullchain.pem
# SSL_KEY=/path/to/privkey.pem
# SSL_FORCE=1

# --- Reverse proxy ---
# Set to 1 when behind a trusted reverse proxy so client IPs come from X-Forwarded-For
TRUST_PROXY=0

# --- CORS ---
# Comma-separated list of allowed browser origins (empty = same-origin only)
CORS_ORIGIN=

# --- Rate limiting ---
# Max requests per IP per minute on /api/* (default 60)
RATE_LIMIT_MAX=60

# --- Static hosting ---
# Serves the built frontend (dist/) from the same server.
# '1' = always, '0' = never, unset = only when NODE_ENV=production and dist/ exists
SERVE_STATIC=1

# --- Vite dev server (optional, dev only) ---
# ALLOWED_HOSTS=localhost,127.0.0.1
